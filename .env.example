# Copia este archivo como .env y ajusta los valores según el entorno.
# Docker Compose lee .env automáticamente desde la misma carpeta.

# Orígenes permitidos para CORS (separados por coma, sin espacios)
# Desarrollo local:
ALLOWED_ORIGINS=http://localhost:8080
